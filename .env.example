# Frontend (copy to .env). Leave empty to run local-only.
VITE_SUPABASE_URL=https://YOUR-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Edge function secrets: supabase secrets set RESEND_API_KEY=... MAIL_FROM="If I Go Quiet <noreply@yourdomain>" APP_URL=https://your-app.vercel.app
# Backend secrets (set with `supabase secrets set KEY=value`, NOT in this file):
# RESEND_API_KEY MAIL_FROM APP_URL ADAPTION_API_KEY AI_MODEL TWILIO_ACCOUNT_SID TWILIO_AUTH_TOKEN TWILIO_FROM TWILIO_WHATSAPP_FROM
